vp staged || exit $?
# The staged paths that match, by git's --diff-filter (the first argument).
staged() {
	filter=$1
	shift
	git diff --cached --name-only --diff-filter="$filter" -- "$@"
}
# What itos reads and no unit test does. The tests below are skipped for the
# ledger, the registry and the smoke set, and nothing else reads them before
# CI, so a broken one rejects the commit here: a duplicate task ID, a static
# check below a late one, a registry item waiting on one that does not exist.
# Both checks read the working tree. They stay here until itos runs them in its
# own commit-msg hook.
# The config, the ledger (itos.yaml's `ledger.files`) and the smoke set
# (`tests.scenario.smoke.file`):
if [ -n "$(staged ACMRD itos.yaml 'tasks/phase-*.yaml' features/smoke.yaml)" ]; then
	tools/bin/itos config check || exit $?
fi
# The work registry (`work.registry`):
if [ -n "$(staged ACMR tasks/work-items.yaml)" ]; then
	tools/bin/itos work check || exit $?
fi
# Commits of only Markdown, docs/, tasks/ (the ledger and the registry) and
# feature files need no test or audit gate: no unit test reads them.
if [ -z "$(staged ACMRD . ':(exclude)*.md' ':(exclude)docs/**' ':(exclude)tasks/**' ':(exclude)features/**/*.feature')" ]; then
	exit 0
fi
# Only the unit tests the change can affect: vitest follows the imports from
# every file changed since HEAD, and `forceRerunTriggers` (vite.config.ts) adds
# what the tests read from disk. The whole suite and its coverage thresholds are
# CI's (`vp run test:coverage`); a partial run cannot hold a threshold, so they
# are off here. Coverage is still collected, because the audit scores the
# changed files by it (see .fallowrc.json), and a changed file's coverage is
# exact: every test that runs it imports it, so every one of them ran.
vp test run --changed HEAD --coverage --coverage.reporter=json \
	--coverage.thresholds.statements=0 --coverage.thresholds.branches=0 \
	--coverage.thresholds.functions=0 --coverage.thresholds.lines=0 || exit $?
# The audit gate (new-only): skip until the repository has a first commit to diff against.
git rev-parse --verify HEAD >/dev/null 2>&1 || exit 0
vp exec fallow audit --quiet --gate-marker pre-commit
